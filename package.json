{
  "name": "vite-kit",
  "version": "0.1.0",
  "description": "Modular Vite/Rolldown build, diagnostics, asset and managed-runtime toolkit for Node.js backends.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "nest": [
        "dist/nest.d.ts"
      ],
      "plugin": [
        "dist/plugin.d.ts"
      ],
      "runtime": [
        "dist/runtime.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "packageManager": "npm@10.9.2",
  "license": "MIT",
  "author": "Kucuks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kucuks/vite-kit.git"
  },
  "homepage": "https://github.com/Kucuks/vite-kit#readme",
  "bugs": {
    "url": "https://github.com/Kucuks/vite-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "bin": {
    "vite-kit": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.cts",
        "default": "./dist/nest.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "perf:product": "tsx test/performance/run-product-performance.ts",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run smoke:nest && npm run audit:prod && npm run pack:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "dev:cli": "tsx src/cli/bin.ts",
    "audit:prod": "npm audit --omit=dev --workspaces=false --prefix .",
    "pack:check": "tsx scripts/verify-package.ts",
    "pack:dry": "npm pack --dry-run --ignore-scripts",
    "smoke:nest": "tsx scripts/smoke-real-nest.ts",
    "test:smoke:nest": "npm run build && npm run smoke:nest"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "typescript": ">=5.6.0 <7",
    "vite": ">=8.0.0 <9"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.0.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "nestjs",
    "vite",
    "vite-plugin",
    "rolldown",
    "nodejs",
    "adapter",
    "framework-agnostic",
    "backend",
    "builder",
    "hmr",
    "restart"
  ]
}
